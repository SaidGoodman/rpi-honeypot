
# Режим киоска: ждём, пока запустится страница мониторинга, и открываем её на весь экран.
# Выйти из киоска: Alt+F4.
sh -c 'until curl -s http://localhost:5000 >/dev/null; do sleep 2; done; chromium http://localhost:5000 --kiosk --noerrdialogs --disable-infobars --no-first-run --password-store=basic' &
