# Сетевая ловушка OpenCanary.
# Работает от root: нужно занять порты 21, 22, 23, 80 и добавить правила iptables
# для обнаружения сканирования. Ключ --dev запускает ловушку на переднем плане,
# чтобы за процессом следил сам systemd.
[Unit]
Description=OpenCanary - сетевая ловушка (honeypot)
After=network-online.target rsyslog.service ssh.service
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=PATH=/opt/opencanary/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/opencanary/venv/bin/opencanaryd --dev
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
