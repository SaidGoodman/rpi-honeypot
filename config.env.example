# Личные настройки стенда. Скопируйте в config.env и поменяйте значения:
#   cp config.env.example config.env
# Файл config.env в git не попадает (см. .gitignore).

# Сеть Wi-Fi, которую раздаёт Pi (system/hotspot.sh)
WIFI_SSID="NAS-Backup"
WIFI_PASSWORD="change-me-please"   # не короче 8 символов
AP_ADDRESS="192.168.50.1/24"       # адрес Pi в этой сети
